<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xsi:type="TaskPaneApp">
  <Id>7b1d3c4e-5f6a-4b8c-9d0e-1f2a3b4c5d6e</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Teslin</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Teslin Auth Test"/>
  <Description DefaultValue="SSO Authentication Test"/>
  <IconUrl DefaultValue="https://dndent.github.io/Database/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://dndent.github.io/Database/icon-64.png"/>
  <SupportUrl DefaultValue="https://teslin.nl"/>
  <AppDomains>
    <AppDomain>https://dndent.github.io</AppDomain>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://dndent.github.io/Authentication/authentication.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <Runtimes>
          <Runtime resid="Functions.Page.Url" lifetime="long"/>
        </Runtimes>
        <AllFormFactors>
          <ExtensionPoint xsi:type="CustomFunctions">
            <Script>
              <SourceLocation resid="Functions.Script.Url"/>
            </Script>
            <Page>
              <SourceLocation resid="Functions.Page.Url"/>
            </Page>
            <Metadata>
              <SourceLocation resid="Functions.Metadata.Url"/>
            </Metadata>
            <Namespace resid="Functions.Namespace"/>
          </ExtensionPoint>
        </AllFormFactors>
      </Host>
    </Hosts>
    <Resources>
      <bt:Urls>
        <bt:Url id="Functions.Script.Url" DefaultValue="https://dndent.github.io/Authentication/authentication.js"/>
        <bt:Url id="Functions.Metadata.Url" DefaultValue="https://dndent.github.io/Authentication/authentication.json"/>
        <bt:Url id="Functions.Page.Url" DefaultValue="https://dndent.github.io/Authentication/authentication.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Functions.Namespace" DefaultValue="AUTHTEST"/>
      </bt:ShortStrings>
    </Resources>
    <WebApplicationInfo>
      <Id>e9dc9cc4-67ae-48c6-a2e2-7e6343f869a9</Id>
      <Resource>api://dndent.github.io/Authentication/e9dc9cc4-67ae-48c6-a2e2-7e6343f869a9</Resource>
      <Scopes>
        <Scope>User.Read</Scope>
      </Scopes>
    </WebApplicationInfo>
  </VersionOverrides>
</OfficeApp>
